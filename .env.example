# Configuración de Supabase (Backend 100% Gratuito en la capa Free de Supabase)
# Crea un proyecto gratis en https://supabase.com y obtén estos valores en Project Settings -> API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# (Opcional) Whitelist de correos con acceso a la consola de administración.
# Si se omite, cualquier usuario autenticado tiene acceso (comportamiento actual).
# VITE_ADMIN_EMAILS=admin@crowcomics.com
